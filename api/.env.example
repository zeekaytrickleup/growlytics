# Copy to .env and adjust. The API boots without a DB and without an AI key
# (graceful fallbacks), so the defaults below are enough for a local demo.

# --- Database: PostgreSQL (free: Neon https://neon.tech, or Supabase) ---
# Local option: run Postgres locally, or just paste your Neon connection string here
# (works for both local dev and prod). The app self-seeds an empty DB on first boot.
DATABASE_URL="postgresql://user:password@localhost:5432/growlytics?schema=public"

# --- Server ---
PORT=4000
# Comma-separated allowed origins. In production set this to your Vercel URL.
WEB_ORIGIN=http://localhost:3000,http://localhost:3007

# --- AI Growth Assistant (optional) ---
# Without a key the assistant returns grounded mock answers.
# Option A (paid): Anthropic Claude (model: claude-opus-4-8).
ANTHROPIC_API_KEY=
# Option B (FREE, no card): Google Gemini — get a key at https://aistudio.google.com/apikey
# Used automatically when ANTHROPIC_API_KEY is empty.
GEMINI_API_KEY=

# --- WooCommerce (optional) — connect a real store ---
# Store must be reachable over public HTTPS. Get the key/secret from:
# WooCommerce -> Settings -> Advanced -> REST API -> Add key (Read permission).
WOO_STORE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
